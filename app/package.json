{
  "name": "paylink-app",
  "version": "0.1.0",
  "private": true,
  "description": "PayLink Phase 1 bare skeleton",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "pg": "8.13.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@nestjs/testing": "10.4.15",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.8",
    "@types/pg": "8.11.11",
    "@types/supertest": "6.0.2",
    "eslint": "9.21.0",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.25.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
